{
	"name": "hatchlight",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"build": "bun run --filter '@hatchlight/web' --filter '@hatchlight/site' build",
		"start": "bun packages/cli/src/index.ts",
		"dev:server": "bun --watch packages/cli/src/index.ts --dev",
		"dev:web": "bun run --filter '@hatchlight/web' dev",
		"dev:site": "bun run --filter '@hatchlight/site' dev",
		"preview:windows": "bun scripts/preview-windows.ts",
		"eval:improve": "bun scripts/eval-improve.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/bun": "latest",
		"fast-check": "4.10.2",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"esbuild": "0.25.12"
	}
}
