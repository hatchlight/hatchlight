{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Hatchlight",
	"version": "0.4.0",
	"identifier": "app.hatchlight.desktop",
	"build": {
		"frontendDist": "../../web/dist",
		"beforeBuildCommand": "bun run prepare-bundle",
		"beforeDevCommand": "bun run prepare-bundle"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		},
		"withGlobalTauri": true
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Photography",
		"shortDescription": "One interface for many image and video generation models",
		"externalBin": ["binaries/hatchlight-server"],
		"resources": {
			"resources/web/": "resources/web/",
			"resources/drizzle/": "resources/drizzle/"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERTdCRjYwNTYyNEMxQzYKUldUR3dTUldZTC9udlYyNDhjQitLcnExTjViVlMzbThzRmZwd2ljWFpFM2pWMkZhUUNQWWh4WTkK",
			"endpoints": [
				"https://github.com/hatchlight/hatchlight/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
